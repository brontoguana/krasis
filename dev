summarize_dynamic_hcs_from_log() {
    local logfile="$1"
    [[ -f "$logfile" ]] || return 0

    local summary
    summary=$(perl -ne '
        s/\e\[[0-9;]*m//g;
        if (/Dynamic HCS: hit=([0-9.]+)% .*?request_promotions=(\d+)\/(\d+) budget_skips=(\d+) no_slot=(\d+) copy_failures=(\d+)/) {
            ($hit, $promotions, $limit, $budget_skips, $no_slot, $copy_failures) = ($1, $2, $3, $4, $5, $6);
        }
        END {
            if (defined $hit) {
                print "hit=${hit}% request_promotions=${promotions}/${limit} budget_skips=${budget_skips} no_slot=${no_slot} copy_failures=${copy_failures}\n";
            }
        }
    ' "$logfile")

    if [[ -n "$summary" ]]; then
        info "Final Dynamic HCS summary: $summary"
    fi
}

