do_perplexity() {
    [[ $# -lt 1 ]] && err "Usage: ./dev perplexity <config> [--dataset wikitext-2] [--max-tokens N] [--max-windows N] [--vram-report]"
    local conf
    conf=$(resolve_config "$1")
    shift
    local vram_report=false
    local -a ppl_args=()
    while [[ $# -gt 0 ]]; do
        if [[ "$1" == "--vram-report" ]]; then
            vram_report=true
        else
            ppl_args+=("$1")
        fi
        shift
    done
    set -- "${ppl_args[@]}"
    cleanup_gpu "$conf"
    auto_rebuild
    local run_dir
    run_dir=$(create_run_dir "dev-perplexity")
    local logfile="$run_dir/perplexity_stdout.log"
    local server_log="$run_dir/perplexity_server.log"
    local port
    port=$(conf_port "$conf")
    [[ -n "$port" ]] || port=8012
    info "Running perplexity through the Rust prefill endpoint: $conf"
    info "Run dir: $run_dir"
    info "Log: $logfile"
    info "Server log: $server_log"
    verify_repo_imports
    local cuda_visible_devices
    cuda_visible_devices=$(resolve_config_cuda_visible_devices "$conf") || \
        err "Could not resolve CFG_SELECTED_GPUS for perplexity"
    if [[ -n "$cuda_visible_devices" ]]; then
        info "Perplexity CUDA_VISIBLE_DEVICES=$cuda_visible_devices"
    fi

    # Perplexity must exercise the current production Rust prefill path.  The
    # former direct model.forward() evaluator depended on Python attention and
    # prefill objects that no longer exist.  Start a test-endpoint server as an
    # exact child of this built command, score through its Rust endpoint, then
    # tear down only that child.
    (
        [[ -z "$cuda_visible_devices" ]] || export CUDA_VISIBLE_DEVICES="$cuda_visible_devices"
        cd "$SCRIPT_DIR"
        export KRASIS_RUN_DIR="$run_dir"
        export KRASIS_RUN_TYPE="dev-perplexity-server"
        local -a server_args=(--config "$conf" --test-endpoints)
        if $vram_report; then
            server_args+=(--vram-report)
        fi
        exec_repo_python -m krasis.server "${server_args[@]}"
    ) > >(tee "$server_log") 2>&1 &
    local server_pid=$!

    cleanup_perplexity_server() {
        if kill -0 "$server_pid" 2>/dev/null; then
            kill -TERM "$server_pid" 2>/dev/null || true
            local waited=0
            while kill -0 "$server_pid" 2>/dev/null && [[ $waited -lt 30 ]]; do
                sleep 1
                waited=$((waited + 1))
            done
            if kill -0 "$server_pid" 2>/dev/null; then
                warn "Perplexity server did not exit after SIGTERM; sending SIGKILL"
                kill -KILL "$server_pid" 2>/dev/null || true
            fi
        fi
        wait "$server_pid" 2>/dev/null || true
    }
    trap 'cleanup_perplexity_server; exit 130' INT TERM
    trap 'cleanup_perplexity_server' EXIT

    local ready=false
    local startup_timeout="${KRASIS_PERPLEXITY_STARTUP_TIMEOUT_SEC:-1200}"
    local elapsed=0
    while kill -0 "$server_pid" 2>/dev/null && [[ $elapsed -lt $startup_timeout ]]; do
        if curl -fsS --max-time 2 "http://127.0.0.1:${port}/health" >/dev/null 2>&1; then
            ready=true
            break
        fi
        sleep 2
        elapsed=$((elapsed + 2))
    done
    if ! $ready; then
        cleanup_perplexity_server
        trap - EXIT INT TERM
        if [[ $elapsed -ge $startup_timeout ]]; then
            err "Perplexity server did not become ready within ${startup_timeout}s; see $server_log"
        fi
        err "Perplexity server exited before becoming ready; see $server_log"
    fi
    ok "Rust prefill endpoint ready on port $port"

    set +e
    (
        [[ -z "$cuda_visible_devices" ]] || export CUDA_VISIBLE_DEVICES="$cuda_visible_devices"
        cd "$SCRIPT_DIR"
        KRASIS_DEV_SCRIPT=1 run_repo_python "$SCRIPT_DIR/tests/rust_prefill_ppl.py" \
            "$conf" --port "$port" "$@"
    ) 2>&1 | tee "$logfile"
    local status=${PIPESTATUS[0]}
    set -e

    cleanup_perplexity_server
    trap - EXIT INT TERM
    info "Perplexity log saved: $logfile"
    return "$status"
}

