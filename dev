do_reference_test() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: ./dev reference-test <config> [--verbose] [--no-server] [--port PORT]"
        echo "       ./dev reference-test --compare <model> [--verbose]"
        echo "  Runs reference test comparing engine output against stored reference data."
        echo "  Use --no-server to connect to an already-running test-endpoint server."
        return 0
    fi
    [[ $# -lt 1 ]] && err "Usage: ./dev reference-test <config> [--verbose] [--no-server] [--port PORT]
       ./dev reference-test --compare <model> [--verbose]
  Runs reference test comparing engine output against BF16 reference data.
  Produces an HTML report in logs/reference-tests/.
  Single config:  ./dev reference-test qwen35-a4
  Comparison:     ./dev reference-test --compare qcn"

    if [[ "$1" == "--compare" ]]; then
        shift
        [[ $# -lt 1 ]] && err "Usage: ./dev reference-test --compare <model>
  Available models: qcn, q35b, q122b
  Single-config aliases: gemma"
        local model="$1"
        shift
        cleanup_gpu
        auto_rebuild
        local run_dir
        run_dir=$(create_run_dir "reference-test")
        info "Running comparative reference test: $model"
        info "Run dir: $run_dir"
        verify_repo_imports
        KRASIS_DEV_SCRIPT=1 KRASIS_RUN_DIR="$run_dir" KRASIS_RUN_TYPE="reference-test" run_repo_python "$SCRIPT_DIR/tests/reference_test.py" --compare "$model" "$@"
	    else
	        local conf
	        conf=$(resolve_config "$1")
	        shift
	        local selected_gpus_override
	        selected_gpus_override=$(extract_selected_gpus_arg "$@")
	        local -a reference_args=()
	        while [[ $# -gt 0 ]]; do
	            case "$1" in
	                --selected-gpus=*) shift ;;
	                --selected-gpus)
	                    [[ $# -ge 2 ]] || err "--selected-gpus requires a comma-separated GPU list"
	                    shift 2
	                    ;;
	                *) reference_args+=("$1"); shift ;;
	            esac
	        done
	        set -- "${reference_args[@]}"
	        local no_server=false
	        local arg
	        for arg in "$@"; do
	            if [[ "$arg" == "--no-server" ]]; then
	                no_server=true
	                break
	            fi
	        done
	        if [[ "$no_server" == true ]]; then
	            info "Reference test using existing server; skipping GPU cleanup/rebuild"
	        else
	            cleanup_gpu "$conf" "$selected_gpus_override"
	            auto_rebuild
	        fi
	        local run_dir
	        run_dir=$(create_run_dir "reference-test")
        info "Running reference test: $conf"
        info "Run dir: $run_dir"
        verify_repo_imports
        KRASIS_DEV_SCRIPT=1 KRASIS_RUN_DIR="$run_dir" KRASIS_RUN_TYPE="reference-test" \
            KRASIS_REFERENCE_SELECTED_GPUS="$selected_gpus_override" \
            run_repo_python "$SCRIPT_DIR/tests/reference_test.py" "$conf" "$@"
    fi
}

