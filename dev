            --artifact-model-name "$(basename "$model_dir")" \
            --artifact-model-path "$model_dir" \
            --profile-id "$profile" \
            "${validator_args[@]}"
    ) 2>&1 | tee "$run_dir/witness_inputs.log"
    ok "Witness input-token source complete: $output"
