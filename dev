do_cpu_tail_calibrate() {
    if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
        echo "Usage: ./dev cpu-tail-calibrate <config> --budget-seconds N --histogram-log PATH [options]"
        echo "Options: --gpu-ordinal N | --gpu-uuid GPU-..., --group-size N, --output PATH,"
        echo "         --histogram-log PATH (repeatable), --baseline-ms-per-token MS,"
        echo "         --isolated-reference-ms MS, --integrated-reference-ms MS,"
        echo "         --two-team --layer-gap-us N, --smoke"
        echo "Standalone Rust calibration only: does not load a model or alter runtime caches."
        return 0
    fi
    [[ $# -ge 1 ]] || err "Usage: ./dev cpu-tail-calibrate <config> --budget-seconds N --histogram-log PATH [options]"
    local config
    config=$(resolve_config "$1")
    shift
    [[ -f "$config" ]] || err "Config not found: $config"
    local run_dir
    run_dir=$(create_run_dir "cpu-tail-calibrate")
    local output="$run_dir/cpu_tail_calibration.json"
    local has_output=false
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--output" ]] && has_output=true
    done
    info "Running standalone Rust CPU-tail calibration"
    info "Config: $config"
    info "Run dir: $run_dir"
    local pyver
    pyver=$("$PYTHON" -c "import sys; print(f'{sys.version_info.major}.{sys.version_info.minor}')")
    local pylibdir
    pylibdir=$("$PYTHON" -c "import sysconfig; print(sysconfig.get_config_var('LIBDIR'))")
    local output_args=()
    if ! $has_output; then
        output_args=(--output "$output")
    fi
    (
        cd "$SCRIPT_DIR"
        PYO3_PYTHON="$PYTHON" \
        LD_LIBRARY_PATH="$pylibdir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
        RUSTFLAGS="${RUSTFLAGS:-} -L $pylibdir -l python${pyver}" \
        PATH="$HOME/.cargo/bin:$(dirname "$PYTHON"):$PATH" \
            cargo run --release --bin cpu-tail-calibrate -- \
            "$config" "${output_args[@]}" "$@"
    ) 2>&1 | tee "$run_dir/cpu_tail_calibration.log"
    ok "CPU-tail calibration complete"
    if ! $has_output; then
        ok "JSON report: $output"
    fi
}

