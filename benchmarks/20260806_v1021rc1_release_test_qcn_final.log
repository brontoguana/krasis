```rust
fn quicksort<T: Ord + Copy>(arr: &mut [T]) {
    if arr.len() <= 1 {
        return;
    }

    let pivot_index = partition(arr);
    
    // Recursively sort the two partitions
    let (left, right) = arr.split_at_mut(pivot_index);
    quicksort(left);
    quicksort(&mut right[1..]); // Skip the pivot element
}

fn partition<T: Ord + Copy>(arr: &mut [T]) -> usize {
    let len = arr.len();
    let pivot_index = len - 1; // Choose last element as pivot
    let pivot = arr[pivot_index];
    
    // i is the index of the smaller element's position
    let mut i = 0;
    
    for j in 0..pivot_index {
        if arr[j] <= pivot {
            arr.swap(i, j);
            i += 1;
        }
    }
    
    // Place pivot in its correct position
    arr.swap(i, pivot_index);
    i
}

