fn quicksort<T: Ord + Clone>(arr: &mut [T]) {
    if arr.len() <= 1 {
        return;
    }

    // Use median-of-three for pivot selection (first, middle, last)
    let len = arr.len();
    let mid = len / 2;
    let mut pivot_idx = mid;

    // Sort first, middle, and last elements to find median
    if arr[0] > arr[mid] {
        arr.swap(0, mid);
    }
    if arr[mid] > arr[len - 1] {
        arr.swap(mid, len - 1);
        if arr[0] > arr[mid] {
            arr.swap(0, mid);
        }
    }

    // Partition around the pivot (now at index mid)
    let pivot = arr[mid].clone();
    let mut left = 0;
    let mut right = len - 1;

    loop {
        while left < len && arr[left] < pivot {
            left += 1;
        }
        while right > 0
