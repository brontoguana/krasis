  [0;32mPrompt:[0m Write me a quicksort implementation in Rust
  [0;36mResponse:[0m Here's a clean, idiomatic in-place quicksort implementation in Rust, using the Hoare partition scheme (which is generally more efficient than Lomuto):

```rust
fn quicksort<T: Ord + Clone>(arr: &mut [T]) {
    if arr.len() <= 1 {
        return;
    }

    let pivot_index = partition(arr);
    let (left, right) = arr.split_at_mut(pivot_index);
    quicksort(left);
    quicksort(&mut right[1..]); // Skip the pivot element
}

fn partition<T: Ord + Clone>(arr: &mut [T]) -> usize {
    let pivot = arr.len() / 2;
    let pivot_value = arr[pivot].clone();
    
    // Swap pivot to the end temporarily
    arr.swap(pivot, arr.len() - 1);
    
    let mut i = 0;
    for j in 0..arr.len() - 1 {
        if arr[j] <= pivot_value {
            arr.swap(i, j);
            i += 1;
        }
    }
    
    // Place pivot in its final position
    arr.swap(i, arr.len() - 1);
    i
}
```

